<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JewelryApp.Home.CheckoutPage"
             BackgroundColor="#EFEFEF"
             NavigationPage.HasNavigationBar="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="20" BackgroundColor="#2B235A">
            <ImageButton Source="undo.svg" WidthRequest="40" HeightRequest="40" BackgroundColor="#4A4177" CornerRadius="20" Padding="10" Clicked="OnBackButtonClicked"/>
            <Label Grid.Column="1" Text="Tổng quan đơn hàng" FontSize="20" FontAttributes="Bold" FontFamily="Serif" VerticalOptions="Center" Margin="15,0,0,0" TextColor="White"/>
        </Grid>

        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="15">

                <Border Stroke="#EFEFEF" StrokeThickness="1" StrokeShape="RoundRectangle 15" BackgroundColor="White" Padding="15">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="ĐỊA CHỈ GIAO HÀNG" FontSize="11" TextColor="#888888" FontAttributes="Bold"/>
                            <Label Text="Nguyễn Thị Lan · 039****177" FontSize="14" FontAttributes="Bold" TextColor="#222222"/>
                            <Label Text="123 Nguyễn Huệ, Phường Bến Nghé, Quận 1, TP. Hồ Chí Minh" FontSize="12" TextColor="#666666" LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Stroke="#EFEFEF" StrokeThickness="1" StrokeShape="RoundRectangle 15" BackgroundColor="White" Padding="0">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="15">
                            <Frame Grid.Column="0" BackgroundColor="#B08920" CornerRadius="4" Padding="6,2" HasShadow="False" VerticalOptions="Center" Margin="0,0,10,0">
                                <Label Text="MALL" FontSize="10" FontAttributes="Bold" TextColor="White"/>
                            </Frame>
                            <Label Grid.Column="1" Text="Hương Jewelry" FontSize="14" FontAttributes="Bold" TextColor="#222222" VerticalOptions="Center"/>
                            <HorizontalStackLayout Grid.Column="2" Spacing="5" VerticalOptions="Center">
                                <Label Text="Ghi chú" FontSize="12" TextColor="#B08920"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#EFEFEF"/>

                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="15">
                            <Image Grid.Column="0" Source="ring_img.png" WidthRequest="60" HeightRequest="60" Aspect="AspectFill" Margin="0,0,15,0">
                                <Image.Clip>
                                    <RoundRectangleGeometry CornerRadius="8" Rect="0,0,60,60"/>
                                </Image.Clip>
                            </Image>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <Label Text="Nhẫn Kim Cương Eternity" FontAttributes="Bold" FontSize="14" TextColor="#222222" FontFamily="Serif"/>
                                <Label Text="Vàng trắng / Size 17" TextColor="#888888" FontSize="11"/>
                                <Label Text="12.500.000đ" TextColor="#B08920" FontAttributes="Bold" FontSize="13"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="x1" FontSize="12" TextColor="#888888" VerticalOptions="Start"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#EFEFEF"/>

                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="15">
                            <Image Grid.Column="0" Source="necklace_img.png" WidthRequest="60" HeightRequest="60" Aspect="AspectFill" Margin="0,0,15,0">
                                <Image.Clip>
                                    <RoundRectangleGeometry CornerRadius="8" Rect="0,0,60,60"/>
                                </Image.Clip>
                            </Image>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <Label Text="Dây Chuyền Vàng 18K" FontAttributes="Bold" FontSize="14" TextColor="#222222" FontFamily="Serif"/>
                                <Label Text="Vàng 18K / 45cm" TextColor="#888888" FontSize="11"/>
                                <Label Text="8.200.000đ" TextColor="#B08920" FontAttributes="Bold" FontSize="13"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="x1" FontSize="12" TextColor="#888888" VerticalOptions="Start"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#EFEFEF"/>

                        <Grid ColumnDefinitions="*, Auto, Auto" Padding="15">
                            <Label Grid.Column="0" Text="Nhận vào 12-15 tháng 10" FontSize="12" TextColor="#222222" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="83.500đ" FontSize="12" TextColor="#888888" TextDecorations="Strikethrough" VerticalOptions="Center" Margin="0,0,10,0"/>
                            <HorizontalStackLayout Grid.Column="2" Spacing="5" VerticalOptions="Center">
                                <Label Text="Miễn phí" FontSize="12" FontAttributes="Bold" TextColor="#00B862"/>
                                <Label Text="&gt;" FontSize="12" TextColor="#888888"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Stroke="#EFEFEF" StrokeThickness="1" StrokeShape="RoundRectangle 15" BackgroundColor="White" Padding="15">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Voucher Hương Jewelry" FontSize="13" TextColor="#222222" VerticalOptions="Center"/>
                        <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                            <Label Text="−83.500đ" FontSize="13" FontAttributes="Bold" TextColor="#00B862"/>
                            <Label Text="&gt;" FontSize="13" TextColor="#888888"/>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <Border Stroke="#EFEFEF" StrokeThickness="1" StrokeShape="RoundRectangle 15" BackgroundColor="White" Padding="15">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Điểm thưởng" FontSize="13" TextColor="#222222" VerticalOptions="Center"/>
                        <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                            <Label Text="Dùng 1.200đ" FontSize="13" FontAttributes="Bold" TextColor="#B08920"/>
                            <Label Text="&gt;" FontSize="13" TextColor="#888888"/>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <Border Stroke="#EFEFEF" StrokeThickness="1" StrokeShape="RoundRectangle 15" BackgroundColor="White" Padding="15">
                    <VerticalStackLayout Spacing="15">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Tóm tắt đơn hàng" FontSize="14" FontAttributes="Bold" TextColor="#222222"/>
                            <Label Grid.Column="1" Text="v" FontSize="12" TextColor="#B08920" FontFamily="Consolas" VerticalOptions="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Tổng phụ sản phẩm" FontSize="13" FontAttributes="Bold" TextColor="#666666"/>
                            <Label Grid.Column="1" Text="20.700.000đ" FontSize="13" FontAttributes="Bold" TextColor="#222222"/>
                        </Grid>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Tổng phụ vận chuyển" FontSize="13" FontAttributes="Bold" TextColor="#666666"/>
                            <Label Grid.Column="1" Text="0đ" FontSize="13" FontAttributes="Bold" TextColor="#222222"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#EFEFEF" Margin="0,5"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Tổng" FontSize="15" FontAttributes="Bold" TextColor="#222222"/>
                            <Label Grid.Column="1" Text="20.700.000đ" FontSize="15" FontAttributes="Bold" TextColor="#B08920"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Stroke="#EFEFEF" StrokeThickness="1" StrokeShape="RoundRectangle 15" BackgroundColor="White" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Phương thức thanh toán" FontSize="14" FontAttributes="Bold" TextColor="#222222" Margin="15,15,15,5"/>

                        <Grid ColumnDefinitions="*, Auto" Padding="15,10" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPay1Tapped" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="Thanh toán khi giao hàng" FontSize="13" FontAttributes="Bold" TextColor="#222222"/>
                                <Label Text="COD" FontSize="11" TextColor="#888888"/>
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                                <Ellipse x:Name="Outer1" Stroke="#B08920" StrokeThickness="2" Fill="Transparent" />
                                <Ellipse x:Name="Dot1" Fill="#B08920" WidthRequest="10" HeightRequest="10" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="True" />
                            </Grid>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#EFEFEF" Margin="15,0"/>

                        <Grid ColumnDefinitions="*, Auto" Padding="15,10" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPay2Tapped" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="Thẻ tín dụng / Ghi nợ" FontSize="13" FontAttributes="Bold" TextColor="#222222"/>
                                <Label Text="Visa, Mastercard, JCB" FontSize="11" TextColor="#888888"/>
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                                <Ellipse x:Name="Outer2" Stroke="#CCCCCC" StrokeThickness="2" Fill="Transparent" />
                                <Ellipse x:Name="Dot2" Fill="#B08920" WidthRequest="10" HeightRequest="10" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False" />
                            </Grid>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#EFEFEF" Margin="15,0"/>

                        <Grid ColumnDefinitions="*, Auto" Padding="15,10" BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPay3Tapped" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="Ví điện tử" FontSize="13" FontAttributes="Bold" TextColor="#222222"/>
                                <Label Text="MoMo · ZaloPay · VNPay" FontSize="11" TextColor="#888888"/>
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                                <Ellipse x:Name="Outer3" Stroke="#CCCCCC" StrokeThickness="2" Fill="Transparent" />
                                <Ellipse x:Name="Dot3" Fill="#B08920" WidthRequest="10" HeightRequest="10" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False" />
                            </Grid>
                        </Grid>

                        <Label FontSize="10" TextColor="#888888" LineBreakMode="WordWrap" Margin="15,10,15,15">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Bằng cách đặt đơn hàng, bạn đồng ý với "/>
                                    <Span Text="Điều khoản sử dụng và bán hàng" TextColor="#B08920"/>
                                    <Span Text=" của Hương Jewelry và đồng ý rằng dữ liệu của bạn sẽ được xử lý theo "/>
                                    <Span Text="Chính sách quyền riêng tư" TextColor="#B08920"/>
                                    <Span Text="."/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Frame Grid.Row="2" BackgroundColor="White" HasShadow="True" Padding="20,15,20,25" CornerRadius="0" BorderColor="Transparent">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="Tổng (2 mặt hàng)" FontSize="11" TextColor="#888888"/>
                    <Label Text="20.700.000đ" FontSize="18" FontAttributes="Bold" TextColor="#B08920"/>
                </VerticalStackLayout>

                <Button Grid.Column="1" Text="Xác nhận đặt hàng" BackgroundColor="#B08920" TextColor="White" FontAttributes="Bold" FontSize="14" CornerRadius="15" Padding="20,12" HeightRequest="50"/>
            </Grid>
        </Frame>

    </Grid>
</ContentPage>