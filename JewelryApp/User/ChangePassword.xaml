<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JewelryApp.User.ChangePassword"
             BackgroundColor="#F9F6F0"
             NavigationPage.HasNavigationBar="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="20,20,20,20" BackgroundColor="#B08920">
            <ImageButton Source="undo.svg" WidthRequest="40" HeightRequest="40" BackgroundColor="#C89D35" CornerRadius="20" Padding="10" Clicked="OnBackButtonClicked"/>
            <Label Grid.Column="1" Text="Thay đổi mật khẩu" FontSize="18" FontAttributes="Bold" FontFamily="Serif" VerticalOptions="Center" Margin="15,0,0,0" TextColor="White"/>
        </Grid>

        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="25">

                <!-- Icon Ổ Khóa & Text -->
                <VerticalStackLayout HorizontalOptions="Center" Spacing="15" Margin="0,10,0,10">
                    <Frame WidthRequest="70" HeightRequest="70" CornerRadius="35" BackgroundColor="#C89D35" HasShadow="False" Padding="15" HorizontalOptions="Center">
                        <Image Source="lock.svg" WidthRequest="30" HeightRequest="30" VerticalOptions="Center" HorizontalOptions="Center"/>
                    </Frame>
                    <Label Text="Mật khẩu mới phải khác mật khẩu cũ và có ít nhất 8 ký tự." FontSize="13" TextColor="#666666" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" Margin="20,0"/>
                </VerticalStackLayout>

                <!-- Form Mật Khẩu -->
                <Border Stroke="#EFEFEF" StrokeThickness="1" StrokeShape="RoundRectangle 15" BackgroundColor="White" Padding="0">
                    <VerticalStackLayout>

                        <!-- Mật khẩu hiện tại -->
                        <VerticalStackLayout Padding="15,12">
                            <Label Text="MẬT KHẨU HIỆN TẠI" FontSize="10" TextColor="#888888"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <Entry Grid.Column="0" Placeholder="Nhập mật khẩu hiện tại" PlaceholderColor="#AAAAAA" TextColor="#222222" FontSize="14" BackgroundColor="Transparent" IsPassword="True"/>
                                <ImageButton Grid.Column="1" Source="eye.svg" WidthRequest="20" HeightRequest="20" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1" Color="#EFEFEF"/>

                        <!-- Mật khẩu mới -->
                        <VerticalStackLayout Padding="15,12">
                            <Label Text="MẬT KHẨU MỚI" FontSize="10" TextColor="#888888"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <Entry Grid.Column="0" Placeholder="Tối thiểu 8 ký tự" PlaceholderColor="#AAAAAA" TextColor="#222222" FontSize="14" BackgroundColor="Transparent" IsPassword="True"/>
                                <ImageButton Grid.Column="1" Source="eye.svg" WidthRequest="20" HeightRequest="20" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1" Color="#EFEFEF"/>

                        <!-- Xác nhận mật khẩu -->
                        <VerticalStackLayout Padding="15,12">
                            <Label Text="XÁC NHẬN MẬT KHẨU MỚI" FontSize="10" TextColor="#888888"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <Entry Grid.Column="0" Placeholder="Nhập lại mật khẩu mới" PlaceholderColor="#AAAAAA" TextColor="#222222" FontSize="14" BackgroundColor="Transparent" IsPassword="True"/>
                                <ImageButton Grid.Column="1" Source="eye.svg" WidthRequest="20" HeightRequest="20" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Box Gợi ý bảo mật -->
                <Border Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 15" BackgroundColor="#F6F4EF" Padding="15">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Gợi ý bảo mật" FontAttributes="Bold" FontSize="13" TextColor="#222222"/>
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="•" TextColor="#B08920" FontSize="12"/>
                            <Label Text="Không dùng tên, ngày sinh làm mật khẩu" FontSize="12" TextColor="#666666"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="•" TextColor="#B08920" FontSize="12"/>
                            <Label Text="Kết hợp chữ hoa, chữ thường, số và ký tự đặc biệt" FontSize="12" TextColor="#666666"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="•" TextColor="#B08920" FontSize="12"/>
                            <Label Text="Không dùng lại mật khẩu từ tài khoản khác" FontSize="12" TextColor="#666666"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Cập nhật mật khẩu" BackgroundColor="#B08920" TextColor="White" FontAttributes="Bold" CornerRadius="15" HeightRequest="50" Margin="0,10,0,30"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>